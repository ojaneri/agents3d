# ===== Agents3D — configuração =====
# Copie para .env e ajuste. O .env NÃO vai pro git.

# --- Autenticação do app (login via overlay, cookie de sessão) ---
# Deixe AUTH_EMAIL e AUTH_PASS vazios para desabilitar o login (NÃO recomendado).
AUTH_EMAIL=voce@exemplo.com
AUTH_PASS=troque-esta-senha
AUTH_SECRET=uma-string-aleatoria-longa

# --- Integração com o OpenClaw (defaults reproduzem uma instalação padrão) ---
# Caminho do binário openclaw:
OPENCLAW_BIN=/usr/local/bin/openclaw
# Home do usuário dono do ~/.openclaw (onde ficam agents/ e openclaw.json):
OPENCLAW_HOME=/root
# Sobrescreva os abaixo só se sua instalação fugir do padrão:
# AGENTS_DIR=/root/.openclaw/agents
# OPENCLAW_CONFIG=/root/.openclaw/openclaw.json
# CACHE_DIR=/run/agents3d
